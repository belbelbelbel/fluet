# Clerk. Also set in Clerk Dashboard → Configure → Paths:
#   Home URL: http://localhost:3000
#   Sign-in / Sign-up URLs as below
#   Allowed redirect URLs:
#     http://localhost:3000
#     http://localhost:3000/*
#     http://localhost:3000/sign-in/sso-callback
#     http://localhost:3000/sign-up/sso-callback
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Disable Clerk telemetry in dev (avoids bundling noise)
CLERK_TELEMETRY_DISABLED=1
# Optional. Clerk uses these for redirects if set
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
SIGNING_SECRET=

# Database (Neon Postgres)
DATABASE_URL=

# AI, DeepSeek (recommended). OpenAI-compatible SDK.
# Get a key: https://platform.deepseek.com
# Base URL: https://api.deepseek.com
# Models: deepseek-v4-flash (captions/ideas) · deepseek-v4-pro (strategy/long)
DEEPSEEK_API_KEY=
# Optional override (default https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI, optional fallback only if DEEPSEEK_API_KEY is empty
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Kora Pay
KORA_API_KEY=
KORA_WEBHOOK_SECRET=
KORA_API_URL=https://api.korapay.com/api/v1/charges
KORA_CURRENCY=NGN

# Email (Resend, transactional notifications)
RESEND_API_KEY=
# Must match the exact domain verified in Resend
RESEND_FROM_EMAIL=notifications@getrevvy.pro
RESEND_FROM_NAME=Revvy
# Optional, monitored inbox (avoid no-reply; helps deliverability)
RESEND_REPLY_TO=hello@getrevvy.pro
# Links inside emails. MUST be your real domain (not localhost) or Gmail spam-filters
EMAIL_APP_URL=https://getrevvy.pro

# App URL (local app + OAuth redirects)
# MUST match the port you run `npm run dev` on (e.g. 3000 or 3001)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal / cron secrets (protect internal API routes)
# Required in production. Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# External pingers: GET /api/cron/post-scheduled?secret=<CRON_SECRET>
# Dry run (no posts): GET /api/cron/post-scheduled?secret=<CRON_SECRET>&dryRun=1
# Schedule runs every 15 minutes (see vercel.json). Hobby plan may only allow daily, so use an external cron if needed.
#
# Prove the publish loop locally (no cron wait):
# 1) Set TWITTER_* keys, Connect Twitter in Settings
# 2) Schedule a tweet with requiresApproval=false (or approve it), scheduled a minute ago / due now
# 3) Settings → Integrations → “Check readiness” then “Run due posts now”
#    Or: POST /api/publish/run-due (while signed in)
CRON_SECRET=
INTERNAL_API_SECRET=

# Twitter OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/oauth2callback

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Instagram / Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/oauth2callback

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Development only
# Usage limits are also skipped automatically while STRIPE_SECRET_KEY and KORA_API_KEY are empty
BYPASS_USAGE_LIMIT=false
