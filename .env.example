# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Disable Clerk telemetry in dev (avoids bundling noise)
CLERK_TELEMETRY_DISABLED=1
SIGNING_SECRET=

# Database (Neon Postgres)
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Kora Pay
KORA_API_KEY=
KORA_WEBHOOK_SECRET=
KORA_API_URL=https://api.korapay.com/api/v1/charges
KORA_CURRENCY=NGN

# Email (Resend — transactional notifications)
RESEND_API_KEY=
# Must match the exact domain verified in Resend (often send.yourdomain.com if DNS uses send subdomain)
RESEND_FROM_EMAIL=Revvy <notifications@send.getrevvy.pro>

# App URL (approval links, email CTAs, OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal / cron secrets (protect internal API routes)
CRON_SECRET=
INTERNAL_API_SECRET=

# OAuth — Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/oauth2callback

# OAuth — YouTube / Google
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# OAuth — Instagram / Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/oauth2callback

# OAuth — Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Development only
# Usage limits are also skipped automatically while STRIPE_SECRET_KEY and KORA_API_KEY are empty
BYPASS_USAGE_LIMIT=false
